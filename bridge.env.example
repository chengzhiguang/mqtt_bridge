MQTT_TOKEN_API=http://192.168.64.1:8082/api/device/mqtt/token
HOME_MAC=

# 推荐使用 ha_service 模式，bridge 直接调用 mqtt_bridge.handle_command
COMMAND_DISPATCH_MODE=ha_service
HA_BASE_URL=http://192.168.64.16
HA_REFRESH_TOKEN=
HA_CLIENT_ID=
HA_TOKEN_URL=http://192.168.64.16/auth/token
HA_COMMAND_SERVICE=mqtt_bridge.handle_command
HA_API_TIMEOUT=10

# 仅在 mqtt 模式下使用本地 Mosquitto
LOCAL_MQTT_HOST=core-mosquitto.local.hass.io
LOCAL_MQTT_PORT=1883
LOCAL_MQTT_USER=mqtt_bridge
LOCAL_MQTT_PASS=MqttBridge@2026

# 日志与运行时
HA_LOG_MIRROR=true
HA_LOG_MIRROR_LEVEL=INFO
HA_LOG_MIRROR_LOGGER=custom_components.mqtt_bridge.bridge
TOKEN_REFRESH_INTERVAL=3600
HA_REGISTRY_REFRESH=60
MQTT_BRIDGE_RUNTIME_DIR=/config/mqtt_bridge_runtime
MQTT_BRIDGE_CONTROL_POLL_INTERVAL=2
HA_HOST=127.0.0.1
HA_PORT=8123
